# Latexo V4 Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.

# Supabase Configuration (Authentication & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq AI API Key (Llama 3.3 70B & Whisper Large v3)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Maintenance Mode Flag (set to "true" to lock down the site)
NEXT_PUBLIC_MAINTENANCE_MODE="false"

# Admin & Cron Security
ADMIN_SECRET_TOKEN=your_admin_secret_token_here
CRON_SECRET=your_cron_secret_token_here

# Email Notifications (Nodemailer Gmail SMTP)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"
